# Copy to .env (repo root) and fill in. Never commit real values.
# The backend reads the root .env, then backend/.env (which overrides it).

# Supabase: Dashboard -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Lets the backend write receipts/images. Never expose to the frontend.
# Without it, run supabase/dev/dev_anon_policies.sql for local testing.
SUPABASE_SECRET_KEY=

# Local only: skip sign-in on every API route. Never enable in production.
DEV_NO_AUTH=true

# Full path to tesseract.exe if it is not on PATH (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
